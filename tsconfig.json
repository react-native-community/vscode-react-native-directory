{
  "compilerOptions": {
    "rootDir": "./src",
    "module": "commonjs",
    "target": "es2024",
    "lib": ["es2024"],
    "esModuleInterop": true,
    "sourceMap": false,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "exclude": ["eslint.config.ts", "node_modules"]
}
